# Copy to .env.local and fill in. Never commit the real file.

# Secret used to sign session JWTs (HS256). Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Shared password for the seeded demo accounts (admin / lawyer / viewer).
DEMO_PASSWORD=change-me

# Optional: artificial API latency in ms so loading states are visible (default 250).
SIMULATED_LATENCY_MS=250

# Optional: probability 0..1 that a mutating API call fails, to demo error recovery (default 0).
SIMULATED_ERROR_RATE=0
